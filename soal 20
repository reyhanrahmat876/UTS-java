 Scanner anka = new Scanner(System.in);
        System.out.print("Masukkan jumlah suku (n): ");
        int n = anka.nextInt();
        int angka = 1;
        System.out.print("Hasil: ");
        for (int i = 1; i <= n; i++) {
            System.out.print(angka + " ");
            int mod = (i - 1) % 3;
            if (mod == 0) {
                angka += 1;
            } else if (mod == 1) {
                angka += 2;
            } else {
                angka += 3;
            }
        }
        System.out.println();
