package com.mycompany.belajar2;


/**
 *
 * @author reyhan rahmatsaputra
 */
public class Belajar2 {
    public static void main(String[] args) {
        for (int i = 1; i <= 6; i++) {
            if (i == 6) {
                for (int j = 0; j < 11; j++) 
                    System.out.print("*");
            } else {
                for (int j = 0; j < i; j++) 
                    System.out.print("*");
                for (int j = 0; j < 11 - (2 * i); j++) 
                    System.out.print(" ");
                for (int j = 0; j < i; j++) 
                    System.out.print("*");
            }
            System.out.println();
        }
    }
}
