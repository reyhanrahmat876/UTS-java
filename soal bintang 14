public class Belajar2 {
    public static void main(String[] args) {
        for (int i = 0; i < 7; i++) {
            for (int j = 0; j < i; j++) 
                System.out.print("*");
            for (int j = 0; j < (7 - i); j++) 
                System.out.print("0");
            System.out.println();
        }
    }
}
