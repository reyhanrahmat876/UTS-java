package com.mycompany.belajar2;


/**
 *
 * @author reyhan rahmatsaputra
 */
public class Belajar2 {
    public static void main(String[] args) {
       int n = 6;
        for (int i = 0; i < n; i++) {
            if (i == 0) {
                for (int j = 0; j < 11; j++) 
                    System.out.print("*");
            } else {
                for (int j = 0; j < n - i; j++) 
                    System.out.print("*");
                for (int j = 0; j < 2 * i - 1; j++) 
                    System.out.print(" ");
                for (int j = 0; j < n - i; j++) 
                    System.out.print("*");
            }
            System.out.println();
        }
    }
}
