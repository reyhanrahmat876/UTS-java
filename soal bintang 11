package com.mycompany.belajar2;


/**
 *
 * @author reyhan rahmatsaputra
 */
public class Belajar2 {
    public static void main(String[] args) {
        for (int i = 0; i < 6; i++) {
            for (int j = 0; j < 11; j++) {
                if (i == 0 || j == 0) {
                    System.out.print("0");
                } else {
                    System.out.print("*");
                }
            }
            System.out.println();
        }
    }
}
