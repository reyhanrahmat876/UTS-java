public class Belajar2 {
    public static void main(String[] args) {
        for (int i = 1; i <= 3; i++) {
            for (int s = 0; s < 3 - i; s++) {
                System.out.print(" ");
            }
            for (int j = 0; j < i; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
        for (int i = 1; i <= 3; i++) {
            for (int j = 0; j < i; j++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
