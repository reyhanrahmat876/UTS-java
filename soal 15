public class Belajar2 {
    public static void main(String[] args) {
       for (int i = 8; i >= 1; i--) {
            if (i == 6 || i == 5 || i == 2) {
                for (int j = 1; j <= i; j++) 
                    System.out.print(i);
            } else {
                for (int j = i; j >= 1; j--) 
                    System.out.print(j);
            }
        }
    }
}
