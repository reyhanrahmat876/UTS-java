package com.mycompany.belajar2;


/**
 *
 * @author reyhan rahmatsaputra
 */
public class Belajar2 {
    public static void main(String[] args) {
       int n = 6;
        for (int i = n - 1; i >= 1; i--) {
            for (int j = n; j > i; j--) 
                System.out.print(" ");
            for (int j = 1; j <= (2 * i - 1); j++) 
                System.out.print("*");
            System.out.println();
        }
    }
}
