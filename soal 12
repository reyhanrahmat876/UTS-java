public class Belajar2 {
    public static void main(String[] args) {
       int n = 9; 
        for (int i = 1; i <= n; i++) {
            if (i % 3 == 2 || i % 3 == 0) { 
                if (i == 2 || i == 5 || i == 6 || i == 9) {
                    for (int j = 1; j <= i; j++) 
                        System.out.print(i);
                } else {
                    for (int j = 1; j <= i; j++) 
                        System.out.print(j);
                }
            } else {
                for (int j = 1; j <= i; j++) 
                    System.out.print(j);
            }
        }
    }
}
